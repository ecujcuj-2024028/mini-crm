# --- CONFIGURACIÓN DEL SERVIDOR ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- BASE DE DATOS (POSTGRESQL VIA DOCKER) ---
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5433/minicrm_db?schema=public"

# --- AUTENTICACIÓN JWT ---
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# --- CONFIGURACIÓN INICIAL DEL SEEDER (ADMIN) ---
ADMIN_NAME="Administrador CRM"
ADMIN_EMAIL="admin@crm.com"
ADMIN_PASSWORD="admin123"
